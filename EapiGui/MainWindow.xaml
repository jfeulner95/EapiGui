<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EapiGui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="EAPI Information">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20,16,20,16" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
            <Style x:Key="NameTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,4,16,4" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="ValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Margin" Value="0,4,0,4" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            </Style>
            <Style x:Key="NotSupportedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Margin" Value="0,4,0,4" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="FontStyle" Value="Italic" />
            </Style>
            <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Margin" Value="0,4,0,4" />
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: library selection and actions -->
        <StackPanel Grid.Row="0" Padding="24,20,24,12" Spacing="12">
            <TextBlock Text="EAPI Information" Style="{StaticResource TitleTextBlockStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DllPathBox"
                         Grid.Column="0"
                         PlaceholderText="EAPI DLL path (empty = search EAPI.dll, EApi_1.dll, EApi64.dll)"
                         KeyDown="DllPathBox_KeyDown" />
                <Button Grid.Column="1" Content="Browse..." Click="BrowseButton_Click" />
                <Button x:Name="LoadButton" Grid.Column="2" Content="Load" Click="LoadButton_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="CopyButton" Grid.Column="3" Content="Copy as text" Click="CopyButton_Click"
                        IsEnabled="False" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <ToggleSwitch x:Name="AutoRefreshSwitch" Header="Auto refresh (2 s)" OnContent="On" OffContent="Off"
                              Toggled="AutoRefreshSwitch_Toggled" IsEnabled="False" />
                <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Bottom"
                              Margin="0,0,0,10" />
                <TextBlock x:Name="LastUpdateText" VerticalAlignment="Bottom" Margin="0,0,0,12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <InfoBar x:Name="StatusInfoBar" Grid.Row="1" Margin="24,0,24,12" IsOpen="False" IsClosable="True" />

        <ScrollViewer Grid.Row="2" Padding="24,0,24,24">
            <StackPanel x:Name="SectionsPanel" Spacing="12" Margin="0,0,0,24" MaxWidth="1100" HorizontalAlignment="Stretch" />
        </ScrollViewer>
    </Grid>
</Window>
